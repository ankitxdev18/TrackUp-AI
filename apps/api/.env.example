# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgres://postgres@localhost:5432/TrackUp

# Cookie & Session Signing Configuration
# Required in production (NODE_ENV=production): Must be a cryptographically secure random secret of >= 32 characters.
# Optional in development: Defaults to an internal development fallback secret if omitted.
COOKIE_SECRET=trackup-session-cookie-secret-dev
