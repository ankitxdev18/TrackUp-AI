# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgres://postgres@localhost:5432/TrackUp

# Cookie & Session Signing Configuration
# Required in production (NODE_ENV=production): Must be a cryptographically secure random secret of >= 32 characters.
# Optional in development: Defaults to an internal development fallback secret if omitted.
COOKIE_SECRET=trackup-session-cookie-secret-dev

# CORS Configuration
# Comma-separated list of trusted frontend origins.
# Required in production (NODE_ENV=production): Must be explicit URLs; wildcards ('*') are strictly rejected.
# Optional in development: Defaults to http://localhost:5173,http://127.0.0.1:5173 if omitted.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting & Proxy Configuration
# AUTH_RATE_LIMIT_MAX: Maximum authentication requests allowed per window per client (default: 10)
# AUTH_RATE_LIMIT_WINDOW_MS: Rate limit sliding window duration in milliseconds (default: 60000 [1 minute])
# GLOBAL_RATE_LIMIT_MAX: General API requests allowed per window per client (default: 100)
# GLOBAL_RATE_LIMIT_WINDOW_MS: General rate limit window in milliseconds (default: 60000 [1 minute])
# TRUST_PROXY: Reverse proxy trust setting (false in local dev; 1 or true in production behind Render load balancer)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=100
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false

